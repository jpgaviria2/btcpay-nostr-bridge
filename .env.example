# BTCPay to Nostr Bridge Configuration
# Copy this file to .env and fill in your values

# ======================
# Nostr Configuration
# ======================

# Your Nostr private key (nsec format or hex)
# Generate with: nak key generate
NOSTR_PRIVATE_KEY=

# Nostr relay URL where campaigns are published and zap receipts will be sent
# Example: wss://relay.yourdomain.com or wss://relay.damus.io
NOSTR_RELAY_URL=

# ======================
# Campaign Configuration
# ======================

# How often to refresh campaigns from relay (in seconds)
# Default: 300 (5 minutes)
CAMPAIGN_REFRESH_INTERVAL=300

# ======================
# BTCPay Configuration
# ======================

# Webhook secret from BTCPay Server
# Generate a random secret when creating the webhook in BTCPay
BTCPAY_WEBHOOK_SECRET=

# BTCPay Server URL (including https://)
# Example: https://btcpay.yourdomain.com
BTCPAY_SERVER_URL=

# BTCPay API key with btcpay.store.canviewinvoices permission
# Create in BTCPay: Account → API Keys → Create Key
BTCPAY_API_KEY=

# ======================
# Service Configuration
# ======================

# Port for webhook server
WEBHOOK_PORT=8765

# Host to bind to (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
WEBHOOK_HOST=0.0.0.0

# Debug mode (true for verbose logging, false for production)
DEBUG=false

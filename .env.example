# BTCPay to Nostr Bridge Configuration

# Nostr Private Key (nsec format or hex)
# Generate with: nak key generate
# Or use an existing key
NOSTR_PRIVATE_KEY=nsec1...

# Fundraising Campaign Configuration
# Get these values by running: python3 setup_query_campaign.py
CAMPAIGN_EVENT_ID=
CAMPAIGN_CREATOR_PUBKEY=

# BTCPay Webhook Secret
# Get this from BTCPay Server when creating the webhook
BTCPAY_WEBHOOK_SECRET=

# Nostr Relay URL
NOSTR_RELAY_URL=wss://relay.anmore.me

# Service Configuration
WEBHOOK_PORT=8765
WEBHOOK_HOST=127.0.0.1

# Debug Mode (set to true for verbose logging)
DEBUG=false
